# OpenSpiel Engine Docker Container
# Installs OpenSpiel Python package and runs the engine server

FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
COPY engines/open_spiel_server.py /app/engines/open_spiel_server.py

RUN pip3 install --no-cache-dir aiohttp aiohttp-cors open-spiel

RUN echo '#!/bin/bash\n\
    export OPENSPIEL_PORT=11216\n\
    exec python3 /app/engines/open_spiel_server.py --port 11216\n\
    ' > /app/start-openspiel.sh && chmod +x /app/start-openspiel.sh

EXPOSE 11216

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:11216/api/status || exit 1

CMD ["/app/start-openspiel.sh"]
