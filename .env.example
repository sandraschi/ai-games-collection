# games-app environment template — copy to .env and fill in (never commit .env)

# --- Gateway ---
GAMES_BACKEND_PORT=10987
GAMES_MCP_LOG_LEVEL=INFO

# Set to 1 when running inside the Tauri desktop shell
GAMES_TAURI=0

# --- Engine URLs (native via start.ps1, or Docker services on the games-net network) ---
# Naked-PC fallback: point at locally launched engine servers
STOCKFISH_URL=http://localhost:11211
SHOGI_URL=http://localhost:11212
GO_URL=http://localhost:11213
EDAX_URL=http://localhost:11214
GNUBG_URL=http://localhost:11215
OPENSPIEL_URL=http://localhost:11216
MOHEX_URL=http://localhost:10775

# --- Multiplayer (optional; only needed for Firebase-backed remote sessions) ---
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Frontend dist override (Tauri/PyInstaller builds) ---
# GAMES_FRONTEND_DIST=web_sota/dist
