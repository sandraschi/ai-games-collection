# YaneuraOu Engine Docker Container
# Downloads official Linux release from GitHub

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    python3 python3-pip curl p7zip-full \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download YaneuraOu Deep ORT-CPU v9.40 (ONNX Runtime, CPU-only for Docker)
RUN curl -L -o yaneuraou.7z "https://github.com/yaneurao/YaneuraOu/releases/download/v9.40/YaneuraOu-Deep-ORT-CPU_V940.7z" \
    && 7z x yaneuraou.7z -o/app/yaneuraou && rm yaneuraou.7z \
    && chmod +x /app/yaneuraou/YaneuraOu*

COPY engines/shogi-server.py /app/engines/shogi-server.py

RUN pip3 install --no-cache-dir aiohttp aiohttp-cors

RUN echo '#!/bin/bash\n\
    export YANEURAOU_PATH=/app/yaneuraou/YaneuraOu\n\
    export YANEURAOU_PORT=11212\n\
    exec python3 /app/engines/shogi-server.py\n\
    ' > /app/start-shogi.sh && chmod +x /app/start-shogi.sh

EXPOSE 11212

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:11212/api/status || exit 1

CMD ["/app/start-shogi.sh"]
