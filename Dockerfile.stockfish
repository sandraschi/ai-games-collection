# Stockfish Engine Docker Container
# Builds Stockfish from source (full strength) and runs Python server wrapper

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    build-essential g++ make \
    python3 python3-pip \
    curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY stockfish/ /app/stockfish/

# Build full-strength Stockfish (AVX2 for modern CPUs)
WORKDIR /app/stockfish/src
RUN make build -j$(nproc) ARCH=x86-64-avx2

RUN test -f /app/stockfish/src/stockfish || (echo "Stockfish build failed" && exit 1)

WORKDIR /app
COPY requirements.txt /app/requirements.txt
COPY engines/stockfish-server.py /app/engines/stockfish-server.py

RUN pip3 install --no-cache-dir aiohttp aiohttp-cors

RUN echo '#!/bin/bash\n\
    export STOCKFISH_PATH=/app/stockfish/src/stockfish\n\
    export AI_STOCKFISH_PORT=11211\n\
    exec python3 /app/engines/stockfish-server.py --port 11211\n\
    ' > /app/start-stockfish.sh && chmod +x /app/start-stockfish.sh

EXPOSE 11211

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:11211/api/status || exit 1

CMD ["/app/start-stockfish.sh"]
